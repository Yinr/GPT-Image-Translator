{
  "tasks": {
    "check": "deno check src/main.ts",
    "fmt": "deno fmt deno.json config.example.yaml docs src tests",
    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net=jsr.io",
    "translate": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi src/main.ts",
    "compile": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --output dist/gpt-image-translator src/main.ts",
    "compile:win": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --output dist/gpt-image-translator-windows-x64.exe --target x86_64-pc-windows-msvc src/main.ts",
    "compile:linux": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --output dist/gpt-image-translator-linux-x64 --target x86_64-unknown-linux-gnu src/main.ts",
    "compile:mac": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --output dist/gpt-image-translator-macos-x64 --target x86_64-apple-darwin src/main.ts",
    "compile:mac-arm": "deno compile --allow-read --allow-write --allow-net --allow-env --allow-ffi --output dist/gpt-image-translator-macos-arm64 --target aarch64-apple-darwin src/main.ts",
    "compile:all": {
      "dependencies": ["compile:win", "compile:linux", "compile:mac", "compile:mac-arm"]
    }
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite",
    "@std/assert": "jsr:@std/assert@1",
    "@std/assert/": "jsr:@std/assert@1/",
    "@std/cli/parse-args": "jsr:@std/cli/parse-args",
    "@std/encoding/base64": "jsr:@std/encoding/base64",
    "@std/fmt/colors": "jsr:@std/fmt@1/colors",
    "@std/fs/walk": "jsr:@std/fs/walk",
    "@std/path": "jsr:@std/path@1",
    "@std/path/": "jsr:@std/path@1/",
    "@matmen/imagescript": "jsr:@matmen/imagescript@1.3.1",
    "@std/yaml": "jsr:@std/yaml@1"
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "singleQuote": false
  }
}
