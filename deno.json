    "test": "deno test --allow-read --allow-write --allow-env --allow-ffi --allow-net=jsr.io",
    "translate": "deno run --allow-read --allow-write --allow-net --allow-env --allow-ffi src/main.ts"
  },
  "imports": {
    "@db/sqlite": "jsr:@db/sqlite",
    "@std/assert": "jsr:@std/assert@1",
    "@std/assert/": "jsr:@std/assert@1/",
    "@std/cli/parse-args": "jsr:@std/cli/parse-args",
    "@std/encoding/base64": "jsr:@std/encoding/base64",
    "@std/fs/walk": "jsr:@std/fs/walk",
    "@std/path": "jsr:@std/path@1",
    "@std/path/": "jsr:@std/path@1/",
    "@matmen/imagescript": "jsr:@matmen/imagescript@1.3.1",
    "@std/yaml": "jsr:@std/yaml@1"
